// Tour Planner — Prisma schema
// Postgres. Conventional prisma-client-js generator (client in node_modules).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PLANNER
  VIEWER
}

enum TripStatus {
  PLANNING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum BookingStatus {
  NOT_BOOKED
  REQUESTED
  CONFIRMED
}

enum CostUnit {
  PER_PERSON
  PER_GROUP
}

enum ShareAudience {
  STAFF
  PARTICIPANT
  HOST_SITE
}

enum BoardType {
  NONE
  BED_AND_BREAKFAST
  HALF_BOARD
  FULL_BOARD
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         Role     @default(PLANNER)
  createdAt    DateTime @default(now())
  trips        Trip[]   @relation("CreatedTrips")
}

model TripType {
  id              String     @id @default(cuid())
  name            String     @unique
  description     String?
  color           String?
  defaultCurrency String     @default("USD")
  locations       Location[] // implicit m2m (tags)
  regions         Region[]   @relation("RegionTripTypes") // regions this type plans in
  trips           Trip[]
}

// Admin-managed, hierarchical place catalog (e.g. England → London). A region can
// apply to several trip types, and a Location belongs to at most one region.
model Region {
  id        String     @id @default(cuid())
  name      String
  parent    Region?    @relation("RegionTree", fields: [parentId], references: [id], onDelete: SetNull)
  parentId  String?
  children  Region[]   @relation("RegionTree")
  tripTypes TripType[] @relation("RegionTripTypes")
  locations Location[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([parentId, name])
  @@index([parentId])
}

model Location {
  id                   String             @id @default(cuid())
  name                 String
  region               Region?            @relation(fields: [regionId], references: [id], onDelete: SetNull)
  regionId             String?
  address              String?
  description          String? // itinerary-facing (shown on shared itineraries)
  notes                String? // internal planning scratch (staff-only)
  website              String?
  mapUrl               String? // optional one-tap "open in maps"
  bookingOpensLeadDays Int? // earliest bookable = startDate - this
  bookingNotes         String?
  scheduleLimitations  String?
  archivedAt           DateTime? // set instead of deleting when referenced by a schedule item
  tripTypes            TripType[] // tags; drives default filtering
  contacts             Contact[] // implicit m2m
  costs                Cost[]
  scheduleItems        ScheduleItemSite[] // schedule items that visit this site
  bookings             Booking[] // bookings made against this location
  hostSite             HostSite? // 1:1 extension; presence ⇒ this location can host/lodge
  stays                Stay[]             @relation("Lodging") // per-trip lodging spans here
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([regionId])
}

model Contact {
  id                   String         @id @default(cuid())
  name                 String
  organization         String?
  role                 String?
  email                String?
  phone                String?
  notes                String?
  locations            Location[] // implicit m2m
  bookings             Booking[]      @relation("BookedBy") // venue contact a booking was made with
  presentedItems       ScheduleItem[] @relation("Presenting") // occurrences this contact speaks at (override)
  presentationDefaults Presentation[] @relation("PresentationDefaults") // talks they're the usual speaker for
}

model Cost {
  id          String    @id @default(cuid())
  location    Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  locationId  String
  label       String
  amount      Decimal   @db.Decimal(10, 2)
  currency    String    @default("USD")
  unit        CostUnit  @default(PER_PERSON)
  confirmedAt DateTime? // price last verified; surfaces stale pricing
  notes       String?
}

model Trip {
  id               String         @id @default(cuid())
  name             String
  tripType         TripType       @relation(fields: [tripTypeId], references: [id])
  tripTypeId       String
  isTemplate       Boolean        @default(false)
  startDate        DateTime?      @db.Date
  endDate          DateTime?      @db.Date
  capacity         Int? // max slots
  participantCount Int? // actual registered headcount (for cost totals)
  status           TripStatus     @default(PLANNING)
  notes            String?
  createdBy        User?          @relation("CreatedTrips", fields: [createdById], references: [id])
  createdById      String?
  days             ItineraryDay[]
  shareLinks       ShareLink[]
  stays            Stay[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model ItineraryDay {
  id               String         @id @default(cuid())
  trip             Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId           String
  dayIndex         Int // 1-based ordering key (NOT unique; renumber in txn)
  date             DateTime?      @db.Date // derived from trip.startDate + (dayIndex - 1)
  title            String?
  logisticalNotes  String? // staff-only on participant/host-site shares
  participantNotes String? // participant-facing free text (devotional theme, scripture, walk notes)
  scheduleItems    ScheduleItem[]

  @@index([tripId])
}

// A configurable kind of schedule item (Visit, Presentation, Meal, Travel…).
// Admin-managed alongside trip types; drives the itinerary label/marker.
model ScheduleItemCategory {
  id        String         @id @default(cuid())
  name      String         @unique
  color     String? // hex; tints the route-line marker
  sortOrder Int            @default(0)
  items     ScheduleItem[]
  createdAt DateTime       @default(now())
}

// A timed line in a day's itinerary. Booking state lives on related Booking
// rows (absent = informational), and 0..n sites attach via ScheduleItemSite.
model ScheduleItem {
  id             String                @id @default(cuid())
  day            ItineraryDay          @relation(fields: [dayId], references: [id], onDelete: Cascade)
  dayId          String
  category       ScheduleItemCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId     String?
  title          String? // label (esp. for site-less items: Lunch, Transit)
  order          Int // ordering within a day (NOT unique; renumber in txn)
  startTime      String? // "HH:MM" — tz-free
  endTime        String?
  notes          String?
  isBlock        Boolean               @default(false) // true = free-choice block of sites (subgroups pick)
  presentation   Presentation?         @relation(fields: [presentationId], references: [id], onDelete: SetNull)
  presentationId String? // the catalogued talk this item delivers (optional)
  presenters     Contact[]             @relation("Presenting") // this occurrence's speaker(s); empty ⇒ presentation.defaultPresenters
  sites          ScheduleItemSite[]
  bookings       Booking[]

  @@index([dayId])
  @@index([categoryId])
  @@index([presentationId])
}

// Join: which locations a schedule item visits. One row = ordinary stop; many = a block.
model ScheduleItemSite {
  id             String       @id @default(cuid())
  scheduleItem   ScheduleItem @relation(fields: [scheduleItemId], references: [id], onDelete: Cascade)
  scheduleItemId String
  location       Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  locationId     String
  order          Int          @default(0) // display order within the item

  @@unique([scheduleItemId, locationId])
  @@index([scheduleItemId])
  @@index([locationId])
}

// A booking tracked against a schedule item (and optionally a specific member location).
// Presence of a Booking is what makes an item "bookable"; none = informational.
// Targets exactly one of a schedule item or a stay (DB CHECK in the migration).
model Booking {
  id              String        @id @default(cuid())
  scheduleItem    ScheduleItem? @relation(fields: [scheduleItemId], references: [id], onDelete: Cascade)
  scheduleItemId  String?
  stay            Stay?         @relation(fields: [stayId], references: [id], onDelete: Cascade)
  stayId          String?       @unique
  location        Location?     @relation(fields: [locationId], references: [id], onDelete: SetNull)
  locationId      String? // which member location this booking is for (null = the item as a whole)
  label           String? // what's being booked (esp. for site-less bookings: coach, restaurant)
  status          BookingStatus @default(NOT_BOOKED)
  bookedContact   Contact?      @relation("BookedBy", fields: [bookedContactId], references: [id], onDelete: SetNull)
  bookedContactId String?
  confirmationRef String?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([scheduleItemId])
  @@index([locationId])
}

model ShareLink {
  id             String        @id @default(cuid())
  trip           Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId         String
  token          String        @unique @default(cuid()) // unguessable URL segment
  audience       ShareAudience @default(PARTICIPANT)
  label          String?
  fieldOverrides Json? // optional per-link tweaks over the audience preset
  enabled        Boolean       @default(true)
  expiresAt      DateTime?
  createdAt      DateTime      @default(now())

  @@index([tripId])
}

// 1:1 extension of a Location. Presence ⇒ the location can host/lodge the group
// (richer staff-facing matrix; future M7 host-site share target). Host-site-ness
// is a property of the place, global across trips; whether THIS trip lodges there
// is derived from a Stay.
model HostSite {
  id                   String   @id @default(cuid())
  location             Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  locationId           String   @unique
  providesLodging      Boolean  @default(false)
  providesMeals        Boolean  @default(false)
  providesMeetingSpace Boolean  @default(false)
  staffNotes           String?
  logisticsNotes       String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

// Reusable catalog of CONTENT (a talk/session). One talk can recur across trips
// and span multiple items ("…(cont.)"). Per-occurrence speaker override lives on
// ScheduleItem.presenters; empty there ⇒ fall back to defaultPresenters.
model Presentation {
  id                String         @id @default(cuid())
  title             String
  description       String? // itinerary-facing abstract
  notes             String? // staff-only
  durationMinutes   Int?
  archivedAt        DateTime?
  defaultPresenters Contact[]      @relation("PresentationDefaults") // usual speaker(s); pre-fill
  items             ScheduleItem[] // occurrences (1 talk → many items)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

// Per-trip lodging span. MULTIPLE per trip; stays MAY OVERLAP (a base stay spans
// the trip while an excursion stay overrides occupancy for a night — resolved by
// `priority`). Costs are per-Stay and independent (do NOT dedupe nights).
model Stay {
  id                    String    @id @default(cuid())
  trip                  Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId                String
  location              Location  @relation("Lodging", fields: [locationId], references: [id], onDelete: Restrict)
  locationId            String
  label                 String?
  checkIn               DateTime  @db.Date
  checkOut              DateTime  @db.Date
  arrivalTime           String? // "HH:MM"
  departureTime         String?
  board                 BoardType @default(NONE)
  headcount             Int?
  costPerPersonPerNight Decimal?  @db.Decimal(10, 2)
  currency              String    @default("USD")
  priority              Int       @default(0) // higher wins for "tonight's bed" when stays overlap (base=0, excursion>0)
  notes                 String?
  booking               Booking? // via Booking.stayId
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([tripId])
  @@index([locationId])
}
