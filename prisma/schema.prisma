// Tour Planner — Prisma schema
// Postgres. Conventional prisma-client-js generator (client in node_modules).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PLANNER
  VIEWER
}

// Manual override only — the Planning → In progress → Complete lifecycle is
// derived from the trip's dates (deriveTripLifecycle in src/lib/trips.ts).
enum TripStatus {
  ACTIVE
  ARCHIVED
  CANCELLED
}

// A booking's MASTER status — the normalized ladder every workflow's steps
// (its substatuses) map onto, so views can filter "everything in progress"
// whatever workflow a booking follows. The flow is PENDING → IN_PROGRESS →
// CONFIRMED → FINALIZED. With a workflow assigned it is DERIVED from the
// completed steps (each step names the status it reaches — see
// src/lib/booking-workflow.ts) and stored so filters stay plain column reads;
// without one the planner sets it directly. CANCELLED and NOT_NEEDED sit off
// the ladder: manual overrides that step changes leave alone.
enum BookingStatus {
  PENDING // nothing done yet
  IN_PROGRESS // underway: contacted, availability held, form submitted...
  CONFIRMED // secured — the planner no longer needs to chase it
  FINALIZED // nothing left to do: final numbers in, paid, paperwork filed
  CANCELLED // was in play, then called off (payments made stay on record)
  NOT_NEEDED // booking deliberately not required for this trip (bookable venues only)
}

// Whose move a workflow step is: US (the planner — "sign the agreement") or
// VENUE (waiting on them — "confirm availability"). The booking's upcoming step
// decides who holds the ball (src/lib/booking-workflow.ts `waitingOn`).
enum StepActor {
  US
  VENUE
}

enum CostUnit {
  PER_PERSON
  PER_GROUP
}

// What a payment installment's due date is measured from (GH #86 refinement).
// EVENT_START: relative to trip.startDate (offset counts BEFORE start, the
// original behavior). BOOKING: relative to the booking's bookedOn date (offset
// counts AFTER booking). NONE: no deadline — owed until paid, never overdue
// (e.g. a deposit taken at booking with no fixed date). See src/lib/payment-schedule.ts.
enum PaymentAnchor {
  EVENT_START
  BOOKING
  NONE
}

// Unit for a payment installment's offset from its anchor. MONTH/WEEK add
// calendar-aware (see shiftByOffset in src/lib/payment-schedule.ts).
enum PaymentOffsetUnit {
  DAY
  WEEK
  MONTH
}

enum ShareAudience {
  STAFF
  PARTICIPANT
  HOST_SITE
}

// What a subscribable calendar feed (.ics) covers. Exactly one of tripId /
// tripTypeId is set for TRIP / TRIP_TYPE; both null for ALL (DB CHECK
// calendar_feed_scope). These are STAFF-detail feeds (full itinerary incl.
// logistical notes); participant-safe calendar feeds are tracked separately.
enum CalendarFeedScope {
  TRIP
  TRIP_TYPE
  ALL
}

model User {
  id                   String                  @id @default(cuid())
  email                String                  @unique
  name                 String?
  passwordHash         String
  role                 Role                    @default(PLANNER)
  createdAt            DateTime                @default(now())
  trips                Trip[]                  @relation("CreatedTrips")
  authoredNotes        Note[]                  @relation("AuthoredNotes")
  todoistConnection    TodoistConnection?
  tripTodoistLinks     TripTodoistLink[]
  tripTypeTodoistLinks TripTypeTodoistLink[]
  calendarFeeds        CalendarFeed[]          @relation("CreatedCalendarFeeds")
  uploadedDocuments    Document[]              @relation("UploadedDocuments")
  bookingStepsDone     BookingStepCompletion[] @relation("BookingStepCompletedBy")
}

// API key for server-to-server export access. Keys are opaque tpk_* tokens;
// staff only sees the prefix (first 8 chars) and the hash. Scoped to trip types
// (empty = all). Supports key rotation via revocation without deleting history.
model ApiKey {
  id          String    @id @default(cuid())
  name        String // Human-readable label (e.g. "WordPress plugin v2")
  prefix      String // First 8 chars of the key, shown in UI for identification
  keyHash     String    @unique // SHA-256 hex digest of the full key
  tripTypeIds String[] // Empty = all trip types; non-empty = scoped to these IDs
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime? // Tracked for key rotation monitoring
  revokedAt   DateTime? // Non-null = key is revoked; null = active
}

enum TodoistAuthType {
  PERSONAL_TOKEN
  OAUTH
}

// A user's Todoist account link. Personal-token auth today; the shape (authType,
// refreshToken, expiresAt) is ready for an OAuth upgrade without a migration.
// Tokens are AES-256-GCM encrypted at rest (src/lib/crypto.ts) and never
// serialized to the client.
model TodoistConnection {
  id               String          @id @default(cuid())
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           String          @unique
  authType         TodoistAuthType @default(PERSONAL_TOKEN)
  accessToken      String // encrypted
  refreshToken     String? // encrypted; OAuth only
  expiresAt        DateTime? // OAuth access-token expiry
  defaultProjectId String? // fallback Todoist project for pushed follow-ups
  lastReconciledAt DateTime? // throttles the lazy completion reconcile
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

// Per-user routing: this trip's follow-ups go to this Todoist project.
model TripTodoistLink {
  id                 String  @id @default(cuid())
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId             String
  trip               Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId             String
  todoistProjectId   String
  // Denormalized at link time so the trip page can show the project's name
  // without a Todoist API call (GH #50). Null on pre-existing links until the
  // picker self-heals it; display falls back to a generic label.
  todoistProjectName String?

  @@unique([userId, tripId])
  @@index([tripId])
}

// Per-user routing default for a trip type (e.g. all Wesley trips → one project).
model TripTypeTodoistLink {
  id               String   @id @default(cuid())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           String
  tripType         TripType @relation(fields: [tripTypeId], references: [id], onDelete: Cascade)
  tripTypeId       String
  todoistProjectId String

  @@unique([userId, tripTypeId])
  @@index([tripTypeId])
}

model TripType {
  id              String                @id @default(cuid())
  name            String                @unique
  description     String?
  color           String?
  defaultCurrency String                @default("USD")
  locations       Location[] // implicit m2m (tags)
  regions         Region[]              @relation("RegionTripTypes") // regions this type plans in
  trips           Trip[]
  calendarFeeds   CalendarFeed[]
  todoistLinks    TripTypeTodoistLink[]
}

// Admin-managed, hierarchical place catalog (e.g. England → London). A region can
// apply to several trip types, and a Location belongs to at most one region.
model Region {
  id        String         @id @default(cuid())
  name      String
  dialCode  String? // phone country code, digits only (e.g. "44"); children inherit via the parent chain
  parent    Region?        @relation("RegionTree", fields: [parentId], references: [id], onDelete: SetNull)
  parentId  String?
  children  Region[]       @relation("RegionTree")
  tripTypes TripType[]     @relation("RegionTripTypes")
  locations Location[]
  cityDays  ItineraryDay[] @relation("DayCityRegion")
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([parentId, name])
  @@index([parentId])
}

model Location {
  id                     String                        @id @default(cuid())
  name                   String
  region                 Region?                       @relation(fields: [regionId], references: [id], onDelete: SetNull)
  regionId               String?
  address                String?
  description            String? // itinerary-facing (shown on shared itineraries)
  notes                  String? // internal planning scratch (staff-only)
  website                String?
  mapUrl                 String? // optional one-tap "open in maps"
  googlePlaceId          String? // Google Places (New) place ID; preferred over name+address for map links
  lat                    Float? // WGS84; both-or-neither with lng (DB CHECK location_coordinates)
  lng                    Float?
  placeIdCheckedAt       DateTime? // when googlePlaceId was last set/confirmed with Google (refreshed yearly)
  placeIdNeedsReview     Boolean                       @default(false) // Google dropped the ID on refresh; re-link by hand
  bookable               Boolean                       @default(true) // false = never booked (walk-by stops); hidden from booking attention
  bookingOpensLeadDays   Int? // earliest bookable = startDate - this
  bookingNotes           String?
  scheduleLimitations    String?
  archivedAt             DateTime? // set instead of deleting when referenced by a schedule item
  tripTypes              TripType[] // tags; drives default filtering
  contacts               Contact[]                     @relation("ContactToLocation") // implicit m2m
  primaryContact         Contact?                      @relation("LocationPrimaryContact", fields: [primaryContactId], references: [id], onDelete: SetNull)
  primaryContactId       String? // the go-to contact for this venue; must be one of `contacts`
  costs                  Cost[]
  defaultPaymentSchedule LocationPaymentScheduleItem[] // standing payment terms (GH #86); seeds new engagements
  scheduleItems          ScheduleItemSite[] // schedule items that visit this site
  bookings               Booking[] // bookings made against this location
  hostSite               HostSite? // 1:1 extension; presence ⇒ this location can host/lodge
  stays                  Stay[]                        @relation("Lodging") // per-trip lodging spans here
  shareLinks             ShareLink[]                   @relation("HostSiteShareLinks") // HOST_SITE links scoped here
  siteNotes              Note[]                        @relation("LocationNotes") // contact log for this venue
  documents              Document[]                    @relation("LocationDocuments") // venue paperwork reusable across trips
  primaryForDays         ItineraryDay[]                @relation("DayPrimaryLocation") // days that default new items here
  plannedForDays         ItineraryDayLocation[]        @relation("PlannedDayLocations") // rough-plan day assignments (GH #9)
  defaultWorkflow        BookingWorkflow?              @relation("LocationDefaultWorkflow", fields: [defaultWorkflowId], references: [id], onDelete: SetNull)
  defaultWorkflowId      String? // seeds new engagements here (else the global default workflow)
  travelsFrom            TravelLeg[]                   @relation("TravelFrom") // travel legs departing here
  travelsTo              TravelLeg[]                   @relation("TravelTo") // travel legs arriving here
  travelStops            TravelStop[]                  @relation("TravelStopLocation") // en-route stops here
  // Booked via a parent venue: this site's sessions/stays are covered by the
  // PARENT's (trip, parent) engagement. Single level only (a parent has no
  // parent; never itself — DB CHECK location_booked_via_not_self).
  bookedVia              Location?                     @relation("LocationBookedVia", fields: [bookedViaId], references: [id], onDelete: SetNull)
  bookedViaId            String?
  coveredSites           Location[]                    @relation("LocationBookedVia") // child sites booked through this one
  events                 LocationEvent[] // standing events here (Evensong 17:00)
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @updatedAt

  @@index([regionId])
  @@index([primaryContactId])
  @@index([defaultWorkflowId])
  @@index([bookedViaId])
}

model Contact {
  id                   String         @id @default(cuid())
  name                 String
  organization         String?
  role                 String?
  email                String?
  phone                String?
  notes                String?
  locations            Location[]     @relation("ContactToLocation") // implicit m2m
  primaryForLocations  Location[]     @relation("LocationPrimaryContact") // venues where this is the go-to contact
  bookings             Booking[]      @relation("BookedBy") // venue contact a booking was made with
  presentedItems       ScheduleItem[] @relation("Presenting") // occurrences this contact speaks at (override)
  presentationDefaults Presentation[] @relation("PresentationDefaults") // talks they're the usual speaker for
  noteEntries          Note[] // contact-log entries that reference this person
}

model Cost {
  id          String    @id @default(cuid())
  location    Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  locationId  String
  label       String
  amount      Decimal   @db.Decimal(10, 2)
  currency    String    @default("USD")
  unit        CostUnit  @default(PER_PERSON)
  confirmedAt DateTime? // price last verified; surfaces stale pricing
  // Active dates: the line applies to a trip whose start date falls inside
  // [validFrom, validTo] (either bound open; undated = always). A known future
  // price change is a second dated line beside the current one — see
  // `effectiveCosts` in src/lib/costs.ts. DB CHECK cost_validity_order.
  validFrom   DateTime? @db.Date
  validTo     DateTime? @db.Date
  notes       String?
}

model Trip {
  id               String            @id @default(cuid())
  name             String
  tripType         TripType          @relation(fields: [tripTypeId], references: [id])
  tripTypeId       String
  isTemplate       Boolean           @default(false)
  startDate        DateTime?         @db.Date
  endDate          DateTime?         @db.Date
  capacity         Int? // max slots
  participantCount Int? // actual registered headcount (for cost totals)
  status           TripStatus        @default(ACTIVE)
  // The currencies this trip works in (ISO 4217 codes). Trip-scoped currency
  // pickers offer these instead of free text (GH #11); seeded from the trip
  // type's defaultCurrency.
  currencies       String[]          @default([])
  // The currency new stays, bookings and price lines on this trip start in;
  // one of `currencies` (validator-enforced). Seeded from the trip type.
  defaultCurrency  String            @default("USD")
  notes            String?
  createdBy        User?             @relation("CreatedTrips", fields: [createdById], references: [id])
  createdById      String?
  days             ItineraryDay[]
  shareLinks       ShareLink[]
  calendarFeeds    CalendarFeed[]
  stays            Stay[]
  bookings         Booking[] // venue-engagement bookings scoped to this trip
  notesLog         Note[]            @relation("TripNotes")
  documents        Document[]        @relation("TripDocuments") // trip-level files (participant itineraries, rosters)
  todoistLinks     TripTodoistLink[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model ItineraryDay {
  id                String                 @id @default(cuid())
  trip              Trip                   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId            String
  dayIndex          Int // 1-based ordering key (NOT unique; renumber in txn)
  date              DateTime?              @db.Date // derived from trip.startDate + (dayIndex - 1)
  title             String?
  logisticalNotes   String? // staff-only on participant/host-site shares
  participantNotes  String? // participant-facing free text (devotional theme, scripture, walk notes)
  // Default venue for the day: new schedule items pre-fill their location picker
  // with this. Optional; SetNull so archiving/deleting a location never drops days.
  primaryLocation   Location?              @relation("DayPrimaryLocation", fields: [primaryLocationId], references: [id], onDelete: SetNull)
  primaryLocationId String?
  // The day's primary city (a Region node, e.g. "London"). Drives the day header
  // on the WP pilgrimage plugin via the export's cityRegionId; when unset the
  // export derives one (primary location → overnight → first stop). SetNull so
  // deleting a region never drops days.
  cityRegion        Region?                @relation("DayCityRegion", fields: [cityRegionId], references: [id], onDelete: SetNull)
  cityRegionId      String?
  scheduleItems     ScheduleItem[]
  // Rough-plan layer (GH #9): locations intended for this day WITHOUT committing
  // to timed schedule items — "we'll be in this city seeing A, B, C." Promoted
  // into a real ScheduleItem when the day firms up.
  plannedLocations  ItineraryDayLocation[]

  @@index([tripId])
  @@index([primaryLocationId])
  @@index([cityRegionId])
}

// A day-level "rough plan" assignment (GH #9): a location intended for a day at a
// coarse, time-free granularity, distinct from the timed ScheduleItem/ScheduleItemSite
// route. One row per (day, location); `order` sequences the loose cluster; `note` is
// an optional short qualifier ("morning", "if time"). Cascade on the location matches
// ScheduleItemSite — a hard-deleted location drops its rough assignments (but a
// location present in any rough plan is archived rather than hard-deleted; see
// deleteLocation). A planner promotes a row into a real schedule item, which deletes it.
model ItineraryDayLocation {
  id         String       @id @default(cuid())
  day        ItineraryDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  dayId      String
  location   Location     @relation("PlannedDayLocations", fields: [locationId], references: [id], onDelete: Cascade)
  locationId String
  order      Int          @default(0)
  note       String?

  @@unique([dayId, locationId])
  @@index([dayId])
  @@index([locationId])
}

// A configurable kind of schedule item (Visit, Presentation, Meal, Travel…).
// Admin-managed alongside trip types; drives the itinerary label/marker.
model ScheduleItemCategory {
  id             String          @id @default(cuid())
  name           String          @unique
  color          String? // hex; tints the route-line marker
  sortOrder      Int             @default(0)
  // Built-in, self-describing kinds (Free time, Break): protected from
  // edit/delete and special-cased in the item form (times + notes only).
  system         Boolean         @default(false)
  items          ScheduleItem[]
  locationEvents LocationEvent[]
  createdAt      DateTime        @default(now())
}

// A standing event at a venue — "Evensong, 17:00" at a cathedral, a daily
// tour at 11:00 — that a planner adds to a day in one click: the item form
// offers a chosen venue's events, and picking one fills the title, times and
// category and marks the time fixed (the group doesn't control it).
model LocationEvent {
  id         String                @id @default(cuid())
  location   Location              @relation(fields: [locationId], references: [id], onDelete: Cascade)
  locationId String
  title      String
  startTime  String // "HH:MM"
  endTime    String? // "HH:MM"
  category   ScheduleItemCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId String?
  notes      String?
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  @@index([locationId])
  @@index([categoryId])
}

// A timed line in a day's itinerary. Booking state lives on related Booking
// rows (absent = informational), and 0..n sites attach via ScheduleItemSite.
model ScheduleItem {
  id             String                @id @default(cuid())
  day            ItineraryDay          @relation(fields: [dayId], references: [id], onDelete: Cascade)
  dayId          String
  category       ScheduleItemCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId     String?
  title          String? // label (esp. for site-less items: Lunch, Transit)
  order          Int // ordering within a day (NOT unique; renumber in txn)
  startTime      String? // "HH:MM" — tz-free
  endTime        String?
  notes          String?
  isBlock        Boolean               @default(false) // true = free-choice block of sites (subgroups pick)
  fixedTime      Boolean               @default(false) // times we don't control (a public event): shifts/reorders never move it
  presentation   Presentation?         @relation(fields: [presentationId], references: [id], onDelete: SetNull)
  presentationId String? // the catalogued talk this item delivers (optional)
  presenters     Contact[]             @relation("Presenting") // this occurrence's speaker(s); empty ⇒ presentation.defaultPresenters
  sites          ScheduleItemSite[]
  bookings       Booking[]
  travel         TravelLeg? // set ⇒ this item IS a travel span (GH #80)

  @@index([dayId])
  @@index([categoryId])
  @@index([presentationId])
}

enum TravelMethod {
  COACH
  TRAIN
  FERRY
  FLIGHT
  WALK
  TAXI
  OTHER
}

// A structured travel span extending one ScheduleItem (GH #80): origin →
// destination by a method, with optional en-route stops. The item's
// startTime/endTime ARE the depart/arrive times — a real span, replacing the
// old paired start-only "Depart"/"Arrive" items that broke gap math. A travel
// item carries NO ScheduleItemSite rows (origin/destination live here), so it
// reads as the seam between venue runs rather than a member of either; a coach
// reservation attaches as the ordinary site-less item booking.
model TravelLeg {
  id             String       @id @default(cuid())
  scheduleItem   ScheduleItem @relation(fields: [scheduleItemId], references: [id], onDelete: Cascade)
  scheduleItemId String       @unique
  method         TravelMethod @default(COACH)
  // Endpoints: a catalogued location OR free text (both optional — "Coach to
  // Bristol" may only know its destination). SetNull so deleting a location
  // never drops the leg.
  fromLocation   Location?    @relation("TravelFrom", fields: [fromLocationId], references: [id], onDelete: SetNull)
  fromLocationId String?
  fromLabel      String?
  toLocation     Location?    @relation("TravelTo", fields: [toLocationId], references: [id], onDelete: SetNull)
  toLocationId   String?
  toLabel        String?
  stops          TravelStop[]

  @@index([fromLocationId])
  @@index([toLocationId])
}

// An ordered en-route stop on a travel leg (comfort stop, photo stop) — a
// catalogued location or free text, with an optional dwell time. Lives inside
// the leg so it no longer pollutes venue-run grouping as its own item.
model TravelStop {
  id           String    @id @default(cuid())
  travelLeg    TravelLeg @relation(fields: [travelLegId], references: [id], onDelete: Cascade)
  travelLegId  String
  location     Location? @relation("TravelStopLocation", fields: [locationId], references: [id], onDelete: SetNull)
  locationId   String?
  label        String?
  dwellMinutes Int?
  order        Int       @default(0)

  @@index([travelLegId])
  @@index([locationId])
}

// Join: which locations a schedule item visits. One row = ordinary stop; many = a block.
model ScheduleItemSite {
  id             String       @id @default(cuid())
  scheduleItem   ScheduleItem @relation(fields: [scheduleItemId], references: [id], onDelete: Cascade)
  scheduleItemId String
  location       Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  locationId     String
  order          Int          @default(0) // display order within the item

  @@unique([scheduleItemId, locationId])
  @@index([scheduleItemId])
  @@index([locationId])
}

// A booking is either a VENUE ENGAGEMENT — one arrangement with a (trip, location)
// that auto-covers every schedule item in the trip visiting that location plus any
// Stay there — or a SITE-LESS item booking (coach/transport) tied to one schedule
// item via `label`. Targets exactly one of a schedule item or a trip+location
// (DB CHECKs in the migration: num_nonnulls(scheduleItemId, tripId)=1, and
// tripId ⇒ locationId). One engagement per (trip, location) — see @@unique below.
model Booking {
  id              String                  @id @default(cuid())
  scheduleItem    ScheduleItem?           @relation(fields: [scheduleItemId], references: [id], onDelete: Cascade)
  scheduleItemId  String? // set for a site-less / single-session item booking
  trip            Trip?                   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId          String? // set for a venue-engagement booking (with locationId)
  location        Location?               @relation(fields: [locationId], references: [id], onDelete: Cascade)
  locationId      String? // the engaged venue (required when tripId is set)
  label           String? // what's being booked (esp. for site-less bookings: coach, restaurant)
  status          BookingStatus           @default(PENDING)
  bookedContact   Contact?                @relation("BookedBy", fields: [bookedContactId], references: [id], onDelete: SetNull)
  bookedContactId String?
  confirmationRef String?
  notes           String?
  // When the engagement was booked — the anchor date for BOOKING-relative payment
  // installments (GH #86). Planner-set; resolution falls back to createdAt when null.
  bookedOn        DateTime?               @db.Date
  // The negotiated price for THIS engagement (the location cost catalog is the
  // asking price; this is what was actually agreed), itemized like the venue's
  // Cost lines so the total follows the headcount (`agreedTotal` in costs.ts).
  // One currency per booking. Settled when payments cover the total.
  agreedCurrency  String                  @default("USD")
  priceLines      BookingPriceLine[]
  payments        Payment[]
  paymentSchedule PaymentScheduleItem[]
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  notesLog        Note[]                  @relation("BookingNotes")
  documents       Document[]              @relation("BookingDocuments") // signed contracts, invoices, confirmations
  // Admin-defined workflow this booking moves through (null = status set by hand).
  workflow        BookingWorkflow?        @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  workflowId      String?
  stepCompletions BookingStepCompletion[]
  // Denormalized from the workflow progress (recomputed on every step / workflow
  // change, like `status`): the furthest completed step's label and date, so
  // every status pill reads "Availability confirmed · 3 Nov" without a join.
  stageLabel      String?
  stageOn         DateTime?               @db.Date

  @@unique([tripId, locationId]) // one engagement per venue per trip (NULL tripId rows are distinct)
  @@index([scheduleItemId])
  @@index([tripId])
  @@index([locationId])
  @@index([workflowId])
}

// An admin-defined booking workflow — "Booking agreement", "Tickets only",
// "Site visit with meal". Its ordered steps are milestones a planner ticks off
// on each booking that follows it. One workflow may be the global default
// (`isDefault`) that seeds new bookings when the venue names none.
model BookingWorkflow {
  id                  String                @id @default(cuid())
  name                String
  isDefault           Boolean               @default(false)
  sortOrder           Int                   @default(0)
  steps               BookingWorkflowStep[]
  bookings            Booking[]
  defaultForLocations Location[]            @relation("LocationDefaultWorkflow")
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
}

// A milestone in a workflow. `status` is the coarse BookingStatus a booking
// reaches once this step is done (IN_PROGRESS, CONFIRMED or FINALIZED — DB CHECK
// booking_workflow_step_status); a booking's status is the furthest any of its
// completed steps reaches.
model BookingWorkflowStep {
  id             String                  @id @default(cuid())
  workflow       BookingWorkflow         @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  workflowId     String
  label          String
  sortOrder      Int                     @default(0)
  status         BookingStatus           @default(IN_PROGRESS)
  actor          StepActor               @default(US) // who completes this step
  // When the step falls due: this many units BEFORE the trip's start date
  // (both set or neither — DB CHECK booking_workflow_step_due). Until then an
  // upcoming step is not yet anyone's move ("Finalized" two years out is not
  // a to-do); unset = due as soon as it's next. See `stepDueDate`.
  dueOffsetValue Int?
  dueOffsetUnit  PaymentOffsetUnit?
  completions    BookingStepCompletion[]
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@index([workflowId])
}

// A step done on a booking — the row's existence means done. `completedOn` is
// planner-editable (back-date "I emailed them last Tuesday").
model BookingStepCompletion {
  id            String              @id @default(cuid())
  booking       Booking             @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId     String
  step          BookingWorkflowStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  stepId        String
  completedOn   DateTime            @db.Date
  completedBy   User?               @relation("BookingStepCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  completedById String?
  createdAt     DateTime            @default(now())

  @@unique([bookingId, stepId])
  @@index([stepId])
  @@index([completedById])
}

// A payment logged against a booking's agreed price. An engagement is settled
// when its payments sum to at least the agreed amount (compared in the booking's
// agreed currency; mixed-currency logs are summed naively and flagged in the UI).
model Payment {
  id        String   @id @default(cuid())
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId String
  amount    Decimal  @db.Decimal(10, 2)
  currency  String   @default("USD")
  paidOn    DateTime @db.Date
  method    String? // e.g. bank transfer, card, cheque, cash
  note      String?
  createdAt DateTime @default(now())

  @@index([bookingId])
}

// An installment in a booking's payment schedule — "20% deposit due 180 days
// before the trip starts, balance by 30 days out". Amount is EITHER a percentage
// of the booking's agreed price OR a fixed amount in its agreed currency (DB
// CHECK payment_schedule_amount: exactly one). The due date is `offsetValue`
// `offsetUnit`s from the `anchor` (GH #86 refinement): EVENT_START counts BEFORE
// trip.startDate (negative = after), BOOKING counts AFTER the booking's bookedOn
// date, NONE has no deadline (offsetValue/offsetUnit null — DB CHECK
// payment_schedule_anchor). Concrete dates derive on dated trips, so schedules
// templatize/instantiate cleanly.
model PaymentScheduleItem {
  id          String             @id @default(cuid())
  booking     Booking            @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId   String
  label       String? // e.g. "Deposit", "Balance"
  percent     Decimal?           @db.Decimal(5, 2) // of the booking's agreed total
  fixedAmount Decimal?           @db.Decimal(10, 2) // in the booking's agreedCurrency
  anchor      PaymentAnchor      @default(EVENT_START)
  offsetValue Int? // in offsetUnit; anchor-natural direction (EVENT_START=before start, BOOKING=after booking). null iff anchor=NONE
  offsetUnit  PaymentOffsetUnit? // null iff anchor=NONE
  sortOrder   Int                @default(0) // stable display order for equal due dates
  createdAt   DateTime           @default(now())

  @@index([bookingId])
}

// One line of a booking's agreed price, mirroring the venue's `Cost` lines
// ("Admission £12 /person", "Group charge £90"). The agreed total is the
// per-person sum × trip headcount + the per-group sum (`agreedTotal` in
// costs.ts). Amounts are in the booking's agreedCurrency. Edited
// replace-the-whole-set.
model BookingPriceLine {
  id        String   @id @default(cuid())
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId String
  label     String
  amount    Decimal  @db.Decimal(10, 2)
  unit      CostUnit
  order     Int      @default(0)

  @@index([bookingId])
}

// A location's STANDING payment terms (GH #86) — a venue's deposit/balance
// cadence tends to hold year to year ("20% deposit 180 days out, balance by
// 30"), so it lives on the Location like the Cost catalog rather than on one
// trip's booking. New venue engagements pre-fill their PaymentScheduleItem set
// from this (precedence: an instantiated template's own schedule wins, then this
// default, then empty). Same shape/CHECKs as PaymentScheduleItem (amount +
// anchor). A BOOKING-anchored standing term carries no booking date of its own —
// it resolves only once seeded onto a real engagement, like EVENT_START terms
// stay unscheduled until a dated trip.
model LocationPaymentScheduleItem {
  id          String             @id @default(cuid())
  location    Location           @relation(fields: [locationId], references: [id], onDelete: Cascade)
  locationId  String
  label       String? // e.g. "Deposit", "Balance"
  percent     Decimal?           @db.Decimal(5, 2) // of the engagement's agreed total
  fixedAmount Decimal?           @db.Decimal(10, 2) // in the engagement's agreedCurrency
  anchor      PaymentAnchor      @default(EVENT_START)
  offsetValue Int? // in offsetUnit; anchor-natural direction. null iff anchor=NONE
  offsetUnit  PaymentOffsetUnit? // null iff anchor=NONE
  sortOrder   Int                @default(0) // stable display order for equal due dates
  createdAt   DateTime           @default(now())

  @@index([locationId])
}

enum NoteMethod {
  CALL
  EMAIL
  IN_PERSON
  OTHER
}

// A structured contact-log entry — tracks a conversation/contact while arranging a
// trip. Polymorphic: attaches to exactly one of a Location, Booking, Trip, or Stay
// (DB CHECK: num_nonnulls(...) = 1). Generalizable beyond bookings.
model Note {
  id            String     @id @default(cuid())
  body          String
  method        NoteMethod @default(OTHER)
  contact       Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  contactId     String? // the person spoken to, if a catalogued contact
  contactedOn   DateTime   @db.Date // when the contact happened (may differ from createdAt)
  followUp      Boolean    @default(false)
  dueDate       DateTime?  @db.Date // optional follow-up deadline
  todoistTaskId String? // the Todoist task mirroring this follow-up, if pushed

  location   Location? @relation("LocationNotes", fields: [locationId], references: [id], onDelete: Cascade)
  locationId String?
  booking    Booking?  @relation("BookingNotes", fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId  String?
  trip       Trip?     @relation("TripNotes", fields: [tripId], references: [id], onDelete: Cascade)
  tripId     String?
  stay       Stay?     @relation("StayNotes", fields: [stayId], references: [id], onDelete: Cascade)
  stayId     String?

  createdBy   User     @relation("AuthoredNotes", fields: [createdById], references: [id], onDelete: Restrict)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([locationId])
  @@index([bookingId])
  @@index([tripId])
  @@index([stayId])
  @@index([contactId])
  @@index([createdById])
}

model ShareLink {
  id             String        @id @default(cuid())
  trip           Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId         String
  token          String        @unique @default(cuid()) // unguessable URL segment
  audience       ShareAudience @default(PARTICIPANT)
  label          String?
  // Scopes a HOST_SITE link to a single host site (their items + bookings only).
  // Null for STAFF/PARTICIPANT links, which span the whole trip.
  location       Location?     @relation("HostSiteShareLinks", fields: [locationId], references: [id], onDelete: SetNull)
  locationId     String?
  fieldOverrides Json? // optional per-link tweaks over the audience preset
  enabled        Boolean       @default(true)
  expiresAt      DateTime?
  createdAt      DateTime      @default(now())

  @@index([tripId])
  @@index([locationId])
}

// A subscribable iCalendar feed. The token is an unguessable capability (like a
// ShareLink) served at /api/feed/<token>.ics; calendar apps poll it to stay in
// sync. Scope picks which trips it covers (see CalendarFeedScope). Cascade on the
// scoped trip / trip type so deleting them cleans up their feeds.
model CalendarFeed {
  id          String            @id @default(cuid())
  token       String            @unique @default(cuid()) // unguessable URL segment
  scope       CalendarFeedScope
  trip        Trip?             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId      String? // set ⇔ scope = TRIP
  tripType    TripType?         @relation(fields: [tripTypeId], references: [id], onDelete: Cascade)
  tripTypeId  String? // set ⇔ scope = TRIP_TYPE
  label       String?
  enabled     Boolean           @default(true)
  createdBy   User?             @relation("CreatedCalendarFeeds", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
  createdAt   DateTime          @default(now())

  @@index([tripId])
  @@index([tripTypeId])
}

// 1:1 extension of a Location. Presence ⇒ the location can host/lodge the group
// (richer staff-facing matrix; future M7 host-site share target). Host-site-ness
// is a property of the place, global across trips; whether THIS trip lodges there
// is derived from a Stay.
model HostSite {
  id                   String   @id @default(cuid())
  location             Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  locationId           String   @unique
  providesLodging      Boolean  @default(false)
  providesMeals        Boolean  @default(false)
  providesMeetingSpace Boolean  @default(false)
  staffNotes           String?
  logisticsNotes       String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

// Reusable catalog of CONTENT (a talk/session). One talk can recur across trips
// and span multiple items ("…(cont.)"). Per-occurrence speaker override lives on
// ScheduleItem.presenters; empty there ⇒ fall back to defaultPresenters.
model Presentation {
  id                String         @id @default(cuid())
  title             String
  description       String? // itinerary-facing abstract
  notes             String? // staff-only
  durationMinutes   Int?
  archivedAt        DateTime?
  defaultPresenters Contact[]      @relation("PresentationDefaults") // usual speaker(s); pre-fill
  items             ScheduleItem[] // occurrences (1 talk → many items)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

// Per-trip lodging span. MULTIPLE per trip; stays MAY OVERLAP (a base stay spans
// the trip while an excursion stay overrides occupancy for a night — resolved by
// `priority`). Costs are per-Stay and independent (do NOT dedupe nights).
model Stay {
  id                    String     @id @default(cuid())
  trip                  Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId                String
  location              Location   @relation("Lodging", fields: [locationId], references: [id], onDelete: Restrict)
  locationId            String
  // A stay anchors EITHER to absolute dates (dated trip) OR to 1-based day
  // indices (date-less template). Exactly one mode is populated — enforced by a
  // DB CHECK (invisible to Prisma; see the migration). checkInDayIndex mirrors
  // ItineraryDay.dayIndex; checkOutDayIndex may be dayCount+1 (departure morning
  // after the last day), matching how an absolute checkOut can be endDate+1.
  checkIn               DateTime?  @db.Date
  checkOut              DateTime?  @db.Date
  checkInDayIndex       Int?
  checkOutDayIndex      Int?
  arrivalTime           String? // "HH:MM"
  departureTime         String?
  headcount             Int?
  costPerPersonPerNight Decimal?   @db.Decimal(10, 2)
  currency              String     @default("USD")
  priority              Int        @default(0) // higher wins for "tonight's bed" when stays overlap (base=0, excursion>0)
  notes                 String?
  notesLog              Note[]     @relation("StayNotes")
  documents             Document[] @relation("StayDocuments") // stay-specific paperwork (rooming lists, arrival sheets)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  // Lodging booking state lives on the venue engagement Booking(tripId, locationId).

  @@index([tripId])
  @@index([locationId])
}

// --- OAuth 2.1 (MCP remote access) ---

model OAuthClient {
  id                      String   @id @default(cuid())
  clientId                String   @unique @default(cuid())
  clientSecret            String?
  clientName              String?
  redirectUris            String[]
  grantTypes              String[] @default(["authorization_code", "refresh_token"])
  responseTypes           String[] @default(["code"])
  tokenEndpointAuthMethod String   @default("none")
  createdAt               DateTime @default(now())
}

model OAuthAuthorizationCode {
  id                  String    @id @default(cuid())
  code                String    @unique @default(cuid())
  clientId            String
  userId              String
  redirectUri         String
  codeChallenge       String
  codeChallengeMethod String    @default("S256")
  scope               String?
  expiresAt           DateTime
  usedAt              DateTime?
  createdAt           DateTime  @default(now())

  @@index([code])
  @@index([expiresAt])
}

// Long-lived refresh tokens (rotated on every use). Stored hashed (SHA-256); the
// raw token is shown to the client exactly once. A `familyId` ties together all
// tokens descended from a single authorization grant: presenting a refresh token
// that was already rotated (replaced) is treated as theft and revokes the whole
// family. Access tokens stay stateless JWTs — they embed this row's id as `sid`
// so the revocation endpoint can kill the session, but the MCP hot path never
// reads this table.
model OAuthRefreshToken {
  id           String    @id @default(cuid())
  tokenHash    String    @unique
  familyId     String
  clientId     String
  userId       String
  scope        String?
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  createdAt    DateTime  @default(now())

  @@index([familyId])
  @@index([userId])
  @@index([expiresAt])
}

// --- Documents (file management) ---

// What a stored file IS. Purely descriptive — drives grouping and filtering in
// the UI; it never affects who may download (that's `shareAudiences`).
enum DocumentKind {
  CONTRACT
  INVOICE
  RECEIPT
  ITINERARY
  ROSTER
  CONFIRMATION
  PERMIT
  MAP
  OTHER
}

// A file filed against exactly one of a Location / Booking / Trip / Stay (DB
// CHECK: num_nonnulls(locationId, bookingId, tripId, stayId) = 1) — the same
// polymorphism as Note, and for the same reason: a contract belongs to the
// engagement, a printable itinerary to the trip, a floor plan to the venue.
//
// This row is METADATA ONLY. The bytes live in DocumentBlob (1:1) so listing a
// trip's documents never drags megabytes of bytea through Prisma; nothing in the
// app selects the blob except the download routes.
model Document {
  id          String       @id @default(cuid())
  title       String // human label; defaults to the uploaded filename
  description String?
  kind        DocumentKind @default(OTHER)
  filename    String // sanitized original name, used for Content-Disposition
  contentType String // validated against the allowlist in src/lib/documents.ts
  size        Int // bytes
  checksum    String // sha256 hex — integrity + duplicate detection

  // Non-staff audiences allowed to download this through a share link. Empty
  // (the default) = staff-only, i.e. the authenticated app. STAFF share links
  // always see every document on their trip, so STAFF never appears here.
  shareAudiences ShareAudience[] @default([])

  location   Location? @relation("LocationDocuments", fields: [locationId], references: [id], onDelete: Cascade)
  locationId String?
  booking    Booking?  @relation("BookingDocuments", fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId  String?
  trip       Trip?     @relation("TripDocuments", fields: [tripId], references: [id], onDelete: Cascade)
  tripId     String?
  stay       Stay?     @relation("StayDocuments", fields: [stayId], references: [id], onDelete: Cascade)
  stayId     String?

  blob         DocumentBlob?
  uploadedBy   User?         @relation("UploadedDocuments", fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedById String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([locationId])
  @@index([bookingId])
  @@index([tripId])
  @@index([stayId])
  @@index([uploadedById])
  @@index([checksum])
}

// The bytes behind a Document, split out so document listings stay cheap.
// Postgres TOASTs the bytea out-of-line, and the row dies with its Document.
model DocumentBlob {
  id         String   @id @default(cuid())
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId String   @unique
  bytes      Bytes
}
