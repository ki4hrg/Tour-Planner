# --- Database ---
# Postgres connection string. In docker-compose this points at the `postgres` service.
DATABASE_URL="postgresql://tourplanner:tourplanner@localhost:5432/tourplanner?schema=public"

# --- Auth.js (next-auth v5) ---
# Generate with: openssl rand -base64 32   (or: npx auth secret)
AUTH_SECRET="replace-me-with-a-long-random-string"
# Public base URL of the app (used for callbacks / share links).
AUTH_URL="http://localhost:3000"

# --- Initial admin (consumed by prisma/seed.ts on first seed) ---
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-on-first-login"
SEED_ADMIN_NAME="Trip Admin"

# --- docker-compose Postgres (used by the postgres service) ---
POSTGRES_USER="tourplanner"
POSTGRES_PASSWORD="tourplanner"
POSTGRES_DB="tourplanner"

# --- Deploy image (compose pulls this; built & pushed by GitHub Actions) ---
# APP_IMAGE="ghcr.io/<owner>/tour-planner:main"
