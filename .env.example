# NOTE: values are intentionally UNQUOTED. docker-compose / Dockhand treat the
# whole line as the literal value — wrapping in quotes makes the quotes part of
# the value (e.g. POSTGRES_USER="x" becomes the user `"x"`, which breaks PG init
# and the DATABASE_URL). For local host tooling, dotenv strips quotes, so plain
# values work everywhere.

# --- Database ---
# Used by host-run tooling (Prisma CLI, `npm run dev`). In docker-compose the
# app builds its own DATABASE_URL from the POSTGRES_* values and the `postgres`
# service name, so you do NOT need to set DATABASE_URL for compose.
# Local dev maps the container DB to host port 5433 (avoids a system Postgres on 5432).
DATABASE_URL=postgresql://tourplanner:tourplanner@localhost:5433/tourplanner?schema=public

# --- Auth.js (next-auth v5) ---
# Generate with: openssl rand -base64 32   (or: npx auth secret)
AUTH_SECRET=replace-me-with-a-long-random-string
# Public base URL of the app (used for callbacks / share links).
AUTH_URL=http://localhost:3076

# --- First admin ---
# By default the app has NO users and prompts you to create the first admin via
# the in-app /setup page on first run. To pre-seed an admin instead, set
# SEED_ON_START=true and provide both of these (otherwise admin seeding is skipped):
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=change-me
# SEED_ADMIN_NAME=Trip Admin

# --- docker-compose Postgres (used by the postgres service) ---
POSTGRES_USER=tourplanner
POSTGRES_PASSWORD=tourplanner
POSTGRES_DB=tourplanner

# --- Deploy image (compose pulls this; built & pushed by GitHub Actions) ---
# APP_IMAGE=ghcr.io/ki4hrg/tour-planner:main
